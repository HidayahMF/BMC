{
  "name": "bmc-pemadaman-backend",
  "version": "1.0.0",
  "description": "Backend Express + MySQL untuk halaman private /pemadaman BMC",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:frontend": "cd ../frontend && npm run build && node ../backend/scripts/copy-dist.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.1",
    "mysql2": "^3.11.4"
  }
}

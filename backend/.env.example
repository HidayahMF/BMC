# ===== Deploy cPanel (backend serve frontend sekaligus) =====
# Semua traffic (frontend + /api) dilayani satu folder backend.
# Frontend sudah di-build ke ./public (`npm run build:frontend`).

# Application
NODE_ENV=production

# Port Express. Isi sesuai port dari cPanel "Setup Node.js App".
# Di UI cPanel biasanya ada di-set sendiri (misal 3000 / 3001 / 3011...).
# Kalau domain diarahkan lewat .htaccess proxy, port ini yang dipakai di sana.
PORT=3000

# Origin browser untuk CORS. Karena frontend & backend satu domain (same-origin),
# sebenarnya CORS tidak relevan, tapi biarkan akurat agar aman.
# Contoh: CORS_ORIGIN=https://bmc.co.id
CORS_ORIGIN=https://bmc.co.id

# MySQL (cPanel). Isi dari halaman "MySQL Databases" di cPanel.
# DB_HOST biasanya 'localhost' (bukan 127.0.0.1) di cPanel.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bmc_pemadaman
DB_USER=bmc_user_pemadaman
DB_PASSWORD=19Nov2025$#
DB_CONNECTION_LIMIT=10

# Session
# Secret penandatangan cookie. WAJIB string acak panjang (min 32 karakter).
SESSION_SECRET=fed025abdba1d2cd1401bd937509c12524d471e067338edd04537575c12ce204
# Session lifetime dalam milidetik (default = 8 jam)
SESSION_MAX_AGE_MS=28800000
# cPanel + SSL (https) sudah aktif -> set true.
SESSION_SECURE_COOKIE=true